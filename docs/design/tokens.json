{
  "source": "r14-final/*.html CSS variables + R11-R14 specs",
  "colors": {
    "light": {
      "bg": "#FFF8EC",
      "paper": "#FFFCF5",
      "ink": "#35291F",
      "muted": "#79634D",
      "line": "#E8D6BA",
      "red": "#A63D26",
      "gold": "#B3863D",
      "wash": "#F6E8D1",
      "glass": "#FFFCF5B8"
    },
    "dark": {
      "bg": "#211D19",
      "paper": "#30281F",
      "ink": "#F8ECD8",
      "muted": "#C9B69C",
      "line": "#69523B",
      "red": "#FFAC88",
      "gold": "#D9B675",
      "wash": "#403326",
      "glass": "#30281FC4"
    }
  },
  "typography": {
    "heading_font": "Songti SC / Kaiti SC",
    "body_font": "PingFang SC",
    "h1_pt": 30,
    "h2_pt": 19,
    "card_title_pt": 17,
    "body_pt": 15,
    "secondary_pt": 12,
    "caption_pt": 10,
    "min_body_pt": 12,
    "min_caption_pt": 10,
    "line_height": {
      "body": 1.8,
      "serif": 1.55,
      "caption": 1.6
    },
    "dynamic_type": true
  },
  "spacing": {
    "grid_pt": 4,
    "page_margin_phone_pt": [
      18,
      20
    ],
    "page_margin_ipad_pt": [
      24,
      26
    ],
    "card_padding_pt": [
      14,
      20
    ],
    "card_gap_pt": [
      10,
      14
    ],
    "group_gap_pt": [
      18,
      24
    ]
  },
  "radius_pt": {
    "card": [
      14,
      16,
      18,
      20,
      22,
      24
    ],
    "poster": 20,
    "pill": 999
  },
  "controls": {
    "min_touch_pt": 44,
    "floating_back_pt": 44,
    "compass_entry_pt": [
      104,
      44
    ],
    "bottom_tab_avoid_pt": 84,
    "glass_blur_px": 24,
    "glass_saturate": 1.5
  },
  "tabs": [
    "calendar",
    "suishi",
    "selection",
    "countdown",
    "settings"
  ],
  "glass": {
    "only": "navigation/control",
    "content": "never",
    "reduced_transparency": "paper opaque",
    "real_render": "native verification required"
  },
  "forbidden": [
    "hardcoded device widths",
    "stamp/seal assets",
    "glass on content",
    "fixed 112/156 home cards"
  ],
  "source_refs": {
    "screens": "r14-final/screens.json",
    "page_contracts": "../PAGE-CONTRACTS.md",
    "handoff": "../IMPLEMENTATION-HANDOFF.md"
  }
}